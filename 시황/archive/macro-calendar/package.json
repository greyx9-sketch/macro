{
  "name": "macro-calendar",
  "version": "1.0.0",
  "private": true,
  "description": "한국·미국 매크로 경제 캘린더 및 실시간 지표 대시보드",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:lan": "wrangler dev --ip 0.0.0.0",
    "deploy": "node scripts/deploy.mjs",
    "deploy:raw": "wrangler deploy",
    "refresh": "node scripts/refresh.mjs",
    "db:local": "wrangler d1 execute macro-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute macro-db --remote --file=./schema.sql",
    "seed:local": "wrangler d1 execute macro-db --local --command=\"SELECT 1\"",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "wrangler": "^4.114.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260722.1": true
  }
}
